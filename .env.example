# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Обходить RLS. Лише сервер (admin-клієнт, create_order, webhook). Ніколи з префіксом NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Нова Пошта (особистий кабінет → Налаштування → Безпека → API-ключ) ---
NP_API_KEY=

# --- LiqPay (кабінет → Налаштування → API; для розробки — sandbox-ключі) ---
# Обидва ключі потрібні лише на сервері для підпису, тому без NEXT_PUBLIC_
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# --- Застосунок ---
# Базовий URL для result_url / server_url LiqPay. Локально webhook не дійде —
# потрібен тунель або деплой (https://...)
APP_URL=http://localhost:3000
